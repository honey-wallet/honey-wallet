# Copy to .env.local (git-ignored). Variables must be prefixed with VITE_ to reach the client.
#
# VITE_API_URL: base URL of the Honey API server (no trailing slash), e.g.
#   https://api.honeywallet.example
# The landing page posts to ${VITE_API_URL}/api/v1/waitlist. Unset, it defaults to
# https://www.honeywallet.org (Vercel proxies /api to the server); set it to an empty string to keep the waitlist form disabled. The /app developer console falls back to http://localhost:8080.
VITE_API_URL=http://localhost:8080
