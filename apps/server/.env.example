# Copy to .env (git-ignored) and adjust as needed.

# Use 0.0.0.0 to accept connections from other devices (e.g. a phone running Expo Go).
HOST=127.0.0.1
PORT=8080

# combined (default): API + mirrors + collectors + workers + auth retention.
# api: API and Redis mirrors only. worker: collectors/workers/retention, with
# only /health and /ready on HOST:PORT. Metrics remains a separate private listener.
# Both split roles require REDIS_URL and must share REDIS_NAMESPACE with their peers.
# DATABASE_URL and provider/auth configuration remain required by enabled features.
# API readiness checks local dependencies, not remote worker availability; monitor
# worker readiness and queue age separately. This does not enable production execution.
SERVER_ROLE=combined

# Comma-separated list of browser origins allowed to call the API. For the Chrome
# extension, add its exact chrome-extension://<32-character ID> origin here.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

REQUEST_TIMEOUT_SECS=30
MAX_IN_FLIGHT_REQUESTS=256
MAX_REQUEST_BODY_BYTES=65536
SHUTDOWN_TIMEOUT_SECS=15

# Local scaffold mode may run without infrastructure. Set true for any deployment
# that requires PostgreSQL/Redis; startup rejects missing URLs and /ready remains
# 503 until configured dependencies pass background probes. This does NOT enable
# live financial execution. Configured Redis makes pairing distributed.
REQUIRE_INFRASTRUCTURE=false
# Disposable local services: docker compose -p honey-backend-dev -f compose.backend.yaml up -d --wait
# DATABASE_URL=postgres://honey:honey_local_only@127.0.0.1:25432/honey?sslmode=disable
# REDIS_URL=redis://127.0.0.1:26379
# Production: use verified TLS (PostgreSQL sslmode=verify-full, Redis rediss://),
# private networking and secret-managed credentials. Never log these URLs.
# Production: Cloud SQL for PostgreSQL. On Cloud Run, attach the instance and connect
# through its Unix socket (no public IP, no password in the URL host):
# DATABASE_URL=postgres://honey:<password>@/honey?host=/cloudsql/<project>:<region>:<instance>
# Keep DATABASE_MAX_CONNECTIONS within the instance's connection limit.
# Setup: docs/launch/GOOGLE-CLOUD-SETUP.md.
DATABASE_MAX_CONNECTIONS=20
DATABASE_STATEMENT_TIMEOUT_MS=5000
DEPENDENCY_TIMEOUT_MS=1000

# Behind a reverse proxy, set true and list only the proxy's source CIDR(s) below.
# X-Forwarded-For is trusted only when the TCP peer is inside one of those ranges.
# The client is the rightmost X-Forwarded-For entry that is NOT in these ranges;
# everything left of it came from the client and is ignored. Untrusted peers are
# keyed by their socket IP.
#
# Cloud Run (run.app URL or domain mapping): Google's front end connects from the
# link-local range and appends the real client IP to X-Forwarded-For:
#   TRUST_PROXY_HEADERS=true
#   TRUSTED_PROXY_CIDRS=169.254.0.0/16
# Behind an external HTTPS load balancer, it also appends its own frontend IP, so add
# that address too (and its IPv6 address if it has one), e.g.
#   TRUSTED_PROXY_CIDRS=169.254.0.0/16,34.120.1.2/32
# Restrict ingress to the load balancer in that case so the run.app URL can't bypass it.
# The server logs a warning on Cloud Run (K_SERVICE set) while this is false.
TRUST_PROXY_HEADERS=false
# TRUSTED_PROXY_CIDRS=10.20.0.0/16,2001:db8:1234::/48

# Log filter (see tracing-subscriber EnvFilter docs) and format (text | json).
RUST_LOG=honey_server=info,warn
LOG_FORMAT=text
# Wallet sign-in is disabled unless AUTH_ORIGIN, AUTH_CHAIN_ID and DATABASE_URL are set.
# AUTH_ORIGIN is the primary SIWE origin used for originless native clients.
# Exact origins, no trailing slash; HTTPS required except loopback development.
# Chain is an explicit identity scope, not a claim that financial adapters are live.
# AUTH_ORIGIN=http://localhost:5173
# Optional comma-separated exact browser origins; configure each in CORS_ALLOWED_ORIGINS too.
# This lets one deployment issue matching web and installed-extension challenges.
# AUTH_ADDITIONAL_ORIGINS=chrome-extension://abcdefghijklmnopabcdefghijklmnop
# AUTH_CHAIN_ID=1
# Apply the embedded migration explicitly before enabling auth: honey-server migrate
# Schedule honey-server prune-auth every minute (bounded batches, monitor backlog).

# Optional Firebase Auth ID-token verification (Sign in with Apple / Google in the apps).
# Identity only: it proves a Firebase user id (GET /api/v1/me/identity) and grants no
# wallet authority; keys never reach Firebase or this server. Off unless set. Only the
# project id is needed (Firebase console → Project settings); no secret belongs here.
# FIREBASE_PROJECT_ID=your-project-id

# Configured Redis enables distributed one-time pairing (no local fallback on outage).
# Use the same namespace on all replicas of ONE deployment; separate environments.
# Pairing and socket leases require maxmemory-policy=noeviction. Data loss invalidates
# in-flight pairings; users restart the pairing flow. TLS/private ACLs required in production.
REDIS_NAMESPACE=honey:v1
# Public Hyperliquid BTC/ETH/SOL display feed; requires REDIS_URL. No execution enabled.
PRICES_ENABLED=false
# Shared across replicas, plus a local hard bound. Identical values on every replica.
PRICE_MAX_CONNECTIONS=10000
# IPv4 address or IPv6 /64; choose from measured NAT distribution, not user count.
PRICE_MAX_CONNECTIONS_PER_IP=64

# Separate private metrics listener. Disabled if absent; never expose via public ingress.
# METRICS_ADDR=127.0.0.1:29090
# Optional OTLP HTTP/protobuf traces, explicit full path. HTTPS required except loopback
# collector sidecar/dev. No URL credentials/query/fragment. Disabled if absent.
# HONEY_OTLP_TRACES_ENDPOINT=http://127.0.0.1:24318/v1/traces
# 0..1000 (100 = 10%). Public traceparent/baggage cannot control server sampling.
TRACE_SAMPLE_PER_MILLE=100
# Trace queue 2048, batch 256, export deadline 2s, no app-level retries; collector retries.

# Explicit public Earn read registry; max 8 targets. Empty disables collection.
# This is display configuration, NOT a deposit/withdrawal approval or product endorsement.
# Each entry requires protocol (aave_v3|morpho_vault_v2), decimal-string chainId,
# contractAddress, assetAddress and label. No URLs, keys or fees accepted here.
EARN_READ_TARGETS=[]

# Optional Aave execution acceptance environment. Disabled when unset.
# Requires AUTH_CHAIN_ID=31337, DATABASE_URL, REDIS_URL, loopback HOST, and migration 202610180007.
# This path points to an operator-owned mode-0600 JSON file containing the approved
# local-fork proxy and implementation pins, RPC account budget and application
# encryption keys. Never commit it. All replicas of an RPC account need the same
# namespace/scope/interval/cost; see docs/backend/RPC-AND-CONTRACT-IDENTITY.md.
# Only literal http://127.0.0.1 RPC and chain 31337 are accepted; mainnet is rejected.
# AAVE_EXECUTION_CONFIG_FILE=/run/secrets/honey-aave-execution.json
# File schema, key rotation, API contracts and production gaps: docs/backend/AAVE-API.md

# Optional Morpho Vault V2 execution, local fork only. Same prerequisites as Aave.
# Regular 0600 JSON file; contains reviewed contract pins and submission encryption keys.
# MORPHO_EXECUTION_CONFIG_FILE=/run/secrets/honey-morpho-execution.json
# Schema, quotes, redemption semantics and migration rollout: docs/backend/MORPHO-EXECUTION.md

# Optional authenticated Uniswap quote reads. No signing/execution is enabled.
# Requires DATABASE_URL, REDIS_URL, AUTH_CHAIN_ID matching the configured network.
# Mode-0600 JSON contains the Trading API key, shared account quota and token/fee policy.
# UNISWAP_QUOTE_CONFIG_FILE=/run/secrets/honey-uniswap-quotes.json
# Schema, limits, source evidence and unfinished execution: docs/backend/UNISWAP-QUOTES.md

# Local-fork swap lifecycle only; exclusive with UNISWAP_QUOTE_CONFIG_FILE.
# Requires loopback HOST, auth chain 31337, PostgreSQL, Redis and a mode-0600 file.
# Set MAX_REQUEST_BODY_BYTES=196608 (192 KiB) for bounded signed router calldata.
# Synthetic quote/build endpoint must be literal HTTP 127.0.0.1 and use the
# sentinel key local-fixture-only. Never put a production API key in this mode.
# UNISWAP_EXECUTION_CONFIG_FILE=/absolute/path/to/local-uniswap-execution.json

# Optional Relay advisory status poller; requires PostgreSQL, Redis and auth.
# Mode-0600 JSON with server-only credentials and explicit account quota spacing.
# This does not enable quote preparation, deposit execution or verified settlement.
# BRIDGE_STATUS_CONFIG_FILE=/run/secrets/honey-bridge-status.json

# Optional Relay v2 quote-preview endpoint. Requires RELAY API key, authentication,
# PostgreSQL and Redis. Requests force indicativeQuote=true and responses expose only
# ordered display metadata; transaction/signature payloads are discarded. No Relay
# commit/reveal or quote execution is enabled.
# RELAY_API_KEY=managed-secret
# Configuration, explicit migration 202610180010 and limits: docs/backend/BRIDGE-RECOVERY.md

# Optional NEAR Intents 1Click catalog and signed dry quote previews.
# Requires PostgreSQL, Redis and wallet authentication. Keep this partner JWT server-only.
# No deposit address creation, signing, transfer or settlement is enabled.
# NEAR_INTENTS_API_KEY=managed-partner-jwt
# Bridging is NEAR Intents only. Contract and remaining execution work: docs/backend/NEAR-INTENTS.md

# Token pages (GET /api/v1/market/info and /market/chart): About text, links, logo, caps
# and price history from CoinGecko, cached (details 30 min, charts 3 min to 3 h) and served
# stale if CoinGecko is down or rate-limited. Keyless works for light traffic; a free demo
# key (coingecko.com/en/api) raises the limit to 30 calls a minute.
# COINGECKO_API_KEY=managed-secret

# Thesis agent (POST /api/v1/theses). Without NEAR_AI_API_KEY runs answer with fixed
# DRY_RUN theses; the asset registry is the public 1Click token list (no key needed).
# NEAR_AI_API_KEY=managed-secret
# NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
# ONECLICK_BASE_URL=https://1click.chaindefuser.com
# News search for the agent's research step (linkup.so). Without it, runs use only
# the links the user pasted.
# LINKUP_API_KEY=managed-secret
# LINKUP_BASE_URL=https://api.linkup.so/v1
# Thesis runs: 5 per user and 20 in total per minute. With REDIS_URL each run is kept in
# Redis for 24 hours (key <REDIS_NAMESPACE>:{thesis}:run:<runId>), so any instance can
# answer GET /theses/{id}; without Redis runs live in process memory (one instance only).
# Proposals are dry-quoted on 1Click from USDC (NEAR_INTENTS_API_KEY when set; nothing is
# executed). Dry quotes name this NEAR Intents account as recipient and refund; nothing is
# ever sent to it.
# THESIS_QUOTE_ACCOUNT=honey-thesis.near
#
# Real jar buys (POST /api/v1/jar-buys/quote, /deposit, GET /status) use 1Click
# without a key (0.2% fee) or with NEAR_INTENTS_API_KEY. Each quote is capped in USD by
# JAR_BUY_CAP_USD: a whole jar buy, and every Swap in the app too (Swap quotes through the
# same endpoint), plus the Confidential Intents proxy below. Unset, it's 250 (the
# production limit, agreed 2026-11-13). Any value in (0, 1000]; anything else fails at
# startup. The app has its own ceiling on top ($1,000, EXPO_PUBLIC_MAX_SWAP_USD in
# apps/mobile/.env.example), so this is the limit users meet. Lower it for testing:
# JAR_BUY_CAP_USD=25
# Jar buy quotes: 6 per user and 240 in total per minute.
#
# Private (stealth) jars: POST /api/v1/confidential-intents/{quote,generate-intent,
# submit-intent,auth} is a signed-in proxy that adds NEAR_INTENTS_API_KEY server-side
# (6 quotes and 60 other calls per user per minute, under global ceilings of 240 quotes
# and 1200 calls per minute). Bodies are limited to the fields the app sends (no
# appFees or referral), and quotes are capped in USD by JAR_BUY_CAP_USD like jar buys.
# The app never holds the key.
#
# Shared jar DAOs (GET /api/v1/jar-dao/state, /verify-deposit, POST /buy-quote) read
# NEAR mainnet with view calls. Deposit verification of old txs needs an archival RPC.
# NEAR_RPC_URL=https://rpc.mainnet.near.org
# NEP-366 gas relayer for group jar members (POST /jar-dao/relay): a member whose NEAR
# account can't cover a call's gas signs it as a delegate action and the relayer
# account below (RELAYER_*) wraps it in a transaction it pays for. Only proposals
# (at most 50 Tgas) and votes (at most 30 Tgas, or up to 300 Tgas when the proposal on
# chain is a buy or payout through intents.near, a unit record, a member change or a
# vote-policy change) on the member's own group DAO, and their share into it
# (ft_transfer_call of USDC with 1 yoctoNEAR, at most 100 Tgas). Only while the DAO
# still runs the Sputnik code recorded when the group created it (the factory's
# get_default_code_hash). 10 a minute per person, and the NEAR budgets below. Needs
# both this switch and the relayer key; otherwise the endpoint answers 503
# `relayer_off` and members pay their own gas. Run `honey-server migrate` first.
# JAR_RELAYER_ENABLED=0
#
# Group jar fees without sending anyone NEAR they could spend:
# - POST /api/v1/jar-dao/create-dao: Honey's NEAR account creates a group's DAO itself
#   (the Sputnik factory's `create`, paying its 0.1 NEAR deposit and the gas) with the
#   policy the server builds from the group's accepted members, the NEAR accounts they
#   joined with and the majority rule, then records it as /social/groups/{id}/created
#   does. Creator only, once per group, while the group is `creating`.
# - POST /api/v1/jar-dao/sponsor: a member's implicit account that isn't on chain yet
#   gets one yoctoNEAR so it exists (relayed calls need it), once per account, after
#   the group goes ahead. Members' votes and shares go through the relay above.
# Both unset (the default) turns them off: the endpoints answer 503 `sponsor_off`, the
# creator creates the DAO themselves and members pay their own fees. Uses NEAR_RPC_URL. The key is the relayer account's full-access key in
# NEAR key-file form (ed25519:<base58>); keep it in a secret manager, fund the account
# with only a little NEAR (the defaults below are sized for ~5 NEAR), never commit it.
# RELAYER_ACCOUNT_ID=
# RELAYER_PRIVATE_KEY=
#
# What the relayer may spend, in NEAR (decimals allowed). Past a budget, or when its
# balance would drop below the floor, the endpoints answer 503 and members pay their
# own fees. DAO creations (0.1 NEAR deposit plus gas, ~0.12 NEAR reserved each) and
# activations across everyone per 24 hours (0.3: two creations a day), and per person
# per 30 days:
# JAR_SPONSOR_DAILY_BUDGET_NEAR=0.3
# JAR_SPONSOR_USER_BUDGET_NEAR=0.2
# Relayed gas (what NEAR says each relay burnt; a relay is reserved at its attached gas
# plus 5 Tgas of conversion fees, with 25% gas-price headroom, until then) across
# everyone per 24 hours, and per person per 24 hours:
# JAR_RELAY_DAILY_BUDGET_NEAR=0.25
# JAR_RELAY_USER_DAILY_BUDGET_NEAR=0.05
# Honey stops paying anything that would take the relayer below this balance:
# RELAYER_BALANCE_FLOOR_NEAR=0.2
# DAO creations, activations and relays only for wallets linked to a Sign in with Apple
# or Google
# (the app sends its Firebase ID token in an X-Firebase-Token header beside the wallet
# session; one Apple or Google account per wallet). Off by default: fees are paid for
# everyone. Anyone can make a fresh wallet key, so turn this on (1) if creations or
# relays are being farmed. Needs FIREBASE_PROJECT_ID.
# SPONSOR_REQUIRE_VERIFIED_IDENTITY=0
#
# Free gas (GET /api/v1/gas/allowance, POST /gas/solana/sponsor, POST /gas/near/relay).
# Every signed-in person gets this much per rolling 30 days across all chains (US
# dollars, priced with 1Click's live prices; no price means no sponsoring). 0 turns
# free gas off everywhere. Group jar relays and DAO creations above are charged to it
# too. Every relayer's floor is checked against its balance less every reservation on
# that chain still pending.
# Past it the endpoints answer 402 `gas_not_covered` and the app pays its own fee.
# GAS_USER_30D_USD=1
# Each chain's total across everyone per rolling 24 hours, so fresh accounts can't
# drain a relayer: GAS_DAILY_USD_<CHAIN>. Defaults are sized to what each relayer holds
# (Solana ~$2 of SOL, NEAR ~$7, Base/Arbitrum ~$2 of ETH, Polygon ~$1 of POL); any other
# chain defaults to $0.50. GET /api/v1/gas/allowance lists all five.
# GAS_DAILY_USD_SOLANA=1
# GAS_DAILY_USD_NEAR=2
# GAS_DAILY_USD_BASE=0.5
# GAS_DAILY_USD_ARBITRUM=0.5
# GAS_DAILY_USD_POLYGON=0.5
# Each person's own daily cap per chain (rolling 24 hours), so one person can't use up a
# chain's daily total: GAS_USER_DAILY_USD_<CHAIN>, $0.10 by default on every chain.
# Solana rent (capped by the setting below) and group jar relays and DAO creations
# (capped by the JAR_* budgets above) are left out of it. A NEAR send relay reserves up
# to ~0.019 NEAR until it settles, so raise GAS_USER_DAILY_USD_NEAR if NEAR trades above
# ~$5.
# GAS_USER_DAILY_USD_SOLANA=0.1
# GAS_USER_DAILY_USD_NEAR=0.1
# GAS_USER_DAILY_USD_BASE=0.1
# New Solana token accounts whose rent (~0.002 SOL each, the costliest part) Honey pays
# per person per 30 days, within the dollar allowance. Whenever a transaction names
# Honey as an account's funder, its rent is reserved and a slot taken even if the
# account exists (it could be closed before the payment lands); the slot comes back
# when the payment shows no rent was paid. Only for mints 1Click lists:
# GAS_SOLANA_USER_NEW_ACCOUNTS_30D=1
#
# Solana fee payer: the app names this account as fee payer for SOL, USDC and SPL token
# payments (sends, Swap and jar deposits); the server checks the user-signed
# transaction (allow-listed programs and instructions only; the fee payer is in no
# instruction except as funder of the payee's associated token account), simulates it,
# co-signs and sends it. Off unless SOLANA_RELAYER_ENABLED=1 and the key is set. The key
# is the usual Solana keypair form: base58 of the 64-byte secret key (or a
# solana-keygen JSON byte array). Keep it in a secret manager, fund the address with
# only a little SOL, never commit it.
# SOLANA_RELAYER_ENABLED=0
# SOLANA_RELAYER_PRIVATE_KEY=
# Defaults to PORTFOLIO_SOLANA_RPC_URL, then Solana's public mainnet RPC.
# SOLANA_RELAYER_RPC_URL=https://api.mainnet-beta.solana.com
# Honey stops paying before the fee payer drops below this (keeps it rent-exempt):
# SOLANA_RELAYER_FLOOR_SOL=0.003
# Most one transaction may cost Honey, in lamports (fee plus one account's rent):
# GAS_SOLANA_MAX_LAMPORTS=3000000
#
# NEAR free gas for sends and Intents deposits (POST /api/v1/gas/near/relay): the
# relayer above (RELAYER_*) wraps a NEP-366 delegate action from the user: ft_transfer
# or ft_transfer_call into intents.near (one yoctoNEAR) on a token 1Click lists, after
# at most one storage_deposit registering that transfer's receiver (the token's
# minimum, only when unregistered), or near_withdraw on wrap.near. Never NEAR transfers
# or near_deposit: in a delegate action the relayer pays every attached deposit. Uses
# RELAYER_BALANCE_FLOOR_NEAR. Off unless NEAR_GAS_RELAY_ENABLED=1 and the key is set.
# NEAR_GAS_RELAY_ENABLED=0
#
# EVM free gas on Base, Arbitrum and Polygon (never Ethereum mainnet) through EIP-7702
# (POST /api/v1/gas/evm/prepare and /submit, GET /gas/evm/sponsorships/{id}). The wallet
# delegates once per chain to Uniswap's audited Calibur v1.1.0
# (0x000000005c84F8Fd50b21CAC312528A64437030e) and signs each batch; this relayer sends
# it to the wallet's own address with zero value and pays only the gas. A relayer
# transaction not mined after 2 minutes is resent with 12.5% higher fees (at most six
# times); past the wallet's deadline it is replaced at the same nonce by a zero-value
# transfer to the relayer itself, and its charge stays until that nonce is mined (a
# sweeper does this every minute). Only plain
# transfers (native coin, USDC or a token 1Click lists) are paid for: one to anyone, or
# up to six into 1Click deposit addresses the person was quoted. Off unless
# EVM_SPONSOR_ENABLED=1 and the key is set (0x + 64 hex, from Secret Manager
# `evm-relayer-private-key`; never logged). The same EOA on all three chains: fund it
# with ~$2 of ETH on Base and Arbitrum and ~$2 of POL on Polygon. Charged to the
# GAS_USER_30D_USD allowance and GAS_DAILY_USD_BASE / _ARBITRUM / _POLYGON (0.5 each
# suits a ~$2 relayer).
# EVM_SPONSOR_ENABLED=0
# EVM_RELAYER_PRIVATE_KEY=
# Which chains (default all three):
# EVM_SPONSOR_CHAINS=base,arbitrum,polygon
# RPCs (public nodes by default; a keyed URL is fine, it is never logged):
# EVM_SPONSOR_RPC_BASE=https://mainnet.base.org
# EVM_SPONSOR_RPC_ARBITRUM=https://arb1.arbitrum.io/rpc
# EVM_SPONSOR_RPC_POLYGON=https://polygon-bor-rpc.publicnode.com
# Honey stops paying before the relayer drops below these (about $0.30 each):
# EVM_RELAYER_FLOOR_ETH=0.00015
# EVM_RELAYER_FLOOR_POL=3.5
# Most one transaction may reserve (gas limit x max fee, plus Base's L1 fee bound):
# EVM_SPONSOR_MAX_TX_USD=0.05
#
# Remote push for group events (invites, votes, "add your share") through Expo's push
# service: phones register their Expo push token (POST /api/v1/push/tokens) and the
# server pushes each new inbox item once. No Apple or Google keys here: those live in
# the Expo project (EAS credentials). Off unless EXPO_PUSH_ENABLED=1. EXPO_ACCESS_TOKEN
# is only needed when "enhanced push security" is on in the Expo dashboard; keep it in
# a secret manager.
# EXPO_PUSH_ENABLED=0
# EXPO_ACCESS_TOKEN=
#
# Jar market data (GET /api/v1/market/venues, /new-pools, /history) needs no keys:
# DexScreener and GeckoTerminal are public, anchored on the 1Click token list.

# Portfolio reads (GET /portfolio/balances, /portfolio/activity). All optional: each
# defaults to a free, keyless public endpoint. Set paid RPC URLs in production; the
# public nodes rate-limit under load.
# PORTFOLIO_ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
# PORTFOLIO_BASE_RPC_URL=https://mainnet.base.org
# PORTFOLIO_ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
# PORTFOLIO_POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
# PORTFOLIO_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# PORTFOLIO_NEAR_RPC_URL=https://free.rpc.fastnear.com
# PORTFOLIO_ETHEREUM_BLOCKSCOUT_URL=https://eth.blockscout.com
# PORTFOLIO_BASE_BLOCKSCOUT_URL=https://base.blockscout.com
# PORTFOLIO_ARBITRUM_BLOCKSCOUT_URL=https://arbitrum.blockscout.com
# PORTFOLIO_POLYGON_BLOCKSCOUT_URL=https://polygon.blockscout.com
# PORTFOLIO_NEARBLOCKS_URL=https://api.nearblocks.io
# Optional keys (secrets; never logged). NearBlocks' keyless tier allows a few calls a
# minute, so NEAR history is cached 3 minutes per account; a key (bearer) lifts that.
# PORTFOLIO_NEARBLOCKS_API_KEY=
# Etherscan v2 (one free key, every EVM chain): Ethereum, Base, Arbitrum and Polygon history when
# Blockscout doesn't answer (its Cloudflare can challenge some server IPs).
# PORTFOLIO_ETHERSCAN_API_KEY=
# PORTFOLIO_ETHERSCAN_URL=https://api.etherscan.io/v2/api
# Alchemy (one free key, every EVM chain): Ethereum, Base, Arbitrum and Polygon history is read
# from alchemy_getAssetTransfers first when set, then Blockscout, then Etherscan. The key
# rides in the URL path, so request URLs are never logged.
# ALCHEMY_API_KEY=
# Every NEP-141 balance of a NEAR account in one keyless call (FastNEAR).
# PORTFOLIO_FASTNEAR_API_URL=https://api.fastnear.com

# Waitlist invites: `honey-server invite-waitlist [--limit N] [--dry-run] [--email ADDRESS]`
# (one-shot, e.g. a Cloud Run job). Emails the oldest uninvited waitlist rows via Resend,
# ~2 per second, then sets waitlist.invited_at. Needs migration 202611090002 and DATABASE_URL.
# --limit defaults to 50 (max 500). --dry-run prints the count and redacted addresses only.
# RESEND_API_KEY is a secret (Secret Manager); it is never logged. Not needed for --dry-run.
# RESEND_API_KEY=managed-secret
# INVITE_FROM=Honey <team@honeywallet.org>
# INVITE_REPLY_TO=team@honeywallet.org
# The "Get Honey" button and hero link. Defaults to https://www.honeywallet.org/get, which
# apps/web/vercel.json redirects to the right store by device.
# INVITE_GET_URL=https://www.honeywallet.org/get
# Store links, shown small under the button; at least one is required to send. Missing
# ones are left out.
# INVITE_IOS_URL=https://apps.apple.com/app/...
# INVITE_ANDROID_URL=https://play.google.com/store/apps/details?id=...
# INVITE_EXTENSION_URL=https://chromewebstore.google.com/detail/...
