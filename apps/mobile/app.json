{
  "expo": {
    "name": "Honey Wallet",
    "slug": "honey-wallet",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": ["honeywallet", "com.honeywallet.app"],
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.honeywallet.app",
      "usesAppleSignIn": true,
      "icon": {
        "light": "./assets/images/ios-light.png",
        "dark": "./assets/images/ios-dark.png",
        "tinted": "./assets/images/ios-tinted.png"
      },
      "appleTeamId": "38V69R9TA5",
      "infoPlist": { "ITSAppUsesNonExemptEncryption": false }
    },
    "android": {
      "package": "com.honeywallet.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "blockedPermissions": ["com.google.android.gms.permission.AD_ID"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 110,
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Honey Wallet uses your photos so you can choose a profile picture."
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Honey Wallet uses the camera to scan wallet addresses and QR codes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-sharing",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Honey uses Face ID to show your recovery phrase and approve payments."
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Light",
            "ios": "./assets/images/icon-light.png",
            "android": {
              "foregroundImage": "./assets/images/android-icon-foreground.png",
              "backgroundColor": "#FFFFFF"
            }
          },
          {
            "name": "Midnight",
            "ios": "./assets/images/icon-midnight.png",
            "android": {
              "foregroundImage": "./assets/images/android-icon-midnight.png",
              "backgroundColor": "#17140F"
            }
          },
          {
            "name": "Graphite",
            "ios": "./assets/images/icon-graphite.png",
            "android": {
              "foregroundImage": "./assets/images/android-icon-graphite.png",
              "backgroundColor": "#292929"
            }
          }
        ]
      ],
      "./plugins/withQuotedBundleScript",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.466723419259-mo8s1gu589p5qpmsbfrk2f1bk3gpqoi8"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "87e18b01-4634-4131-8172-27b964f999d4"
      }
    }
  }
}
