{
  "expo": {
    "name": "Honey",
    "slug": "honey-wallet",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": ["honeywallet", "com.honeywallet.app"],
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.honeywallet.app",
      "usesAppleSignIn": true,
      "icon": {
        "light": "./assets/images/ios-light.png",
        "dark": "./assets/images/ios-dark.png",
        "tinted": "./assets/images/ios-tinted.png"
      },
      "appleTeamId": "38V69R9TA5",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["remote-notification"],
        "NSPhotoLibraryAddUsageDescription": "Honey saves QR codes and share cards to your photos."
      },
      "associatedDomains": ["applinks:honeywallet.org", "applinks:www.honeywallet.org"]
    },
    "android": {
      "package": "com.honeywallet.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.WRITE_CONTACTS"
      ],
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "honeywallet.org",
              "pathPrefix": "/app"
            },
            {
              "scheme": "https",
              "host": "honeywallet.org",
              "pathPrefix": "/j/"
            },
            {
              "scheme": "https",
              "host": "honeywallet.org",
              "pathPrefix": "/p/"
            },
            {
              "scheme": "https",
              "host": "honeywallet.org",
              "pathPrefix": "/u/"
            },
            {
              "scheme": "https",
              "host": "www.honeywallet.org",
              "pathPrefix": "/app"
            },
            {
              "scheme": "https",
              "host": "www.honeywallet.org",
              "pathPrefix": "/j/"
            },
            {
              "scheme": "https",
              "host": "www.honeywallet.org",
              "pathPrefix": "/p/"
            },
            {
              "scheme": "https",
              "host": "www.honeywallet.org",
              "pathPrefix": "/u/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 110,
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Honey uses your photos so you can choose a profile picture.",
          "microphonePermission": false,
          "cameraPermission": "Honey uses the camera to scan wallet addresses and QR codes."
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Honey uses the camera to scan wallet addresses and QR codes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-sharing",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Honey uses Face ID to show your recovery phrase and approve payments."
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Light",
            "ios": "./assets/images/icon-light.png",
            "android": {
              "foregroundImage": "./assets/images/android-icon-foreground.png",
              "backgroundColor": "#FFFFFF"
            }
          },
          {
            "name": "Midnight",
            "ios": "./assets/images/icon-midnight.png",
            "android": {
              "foregroundImage": "./assets/images/android-icon-midnight.png",
              "backgroundColor": "#17140F"
            }
          },
          {
            "name": "Graphite",
            "ios": "./assets/images/icon-graphite.png",
            "android": {
              "foregroundImage": "./assets/images/android-icon-graphite.png",
              "backgroundColor": "#292929"
            }
          }
        ]
      ],
      "./plugins/withQuotedBundleScript",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.466723419259-mo8s1gu589p5qpmsbfrk2f1bk3gpqoi8"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F5C451",
          "mode": "production"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Honey uses your contacts so you can find friends and invite them to a jar."
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [],
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "Honey uses Bluetooth to connect your Ledger hardware wallet."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "87e18b01-4634-4131-8172-27b964f999d4"
      }
    }
  }
}
